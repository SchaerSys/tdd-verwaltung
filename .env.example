# ── TDD-Verwaltung · Umgebungsvariablen (Vorlage) ──────────────────────────
# Kopiere nach .env (Server) bzw. apps/web/.env.local (lokal) und fülle aus.

# App-Datenbankrolle (RBAC-gefiltert, KEIN Superuser) – für die Fach-App
DATABASE_URL="postgresql://tdd_app:CHANGE_ME@localhost:5432/tdd"

# Betreiber-/Wartungsrolle (NUR Metadaten, KEIN PII-Lesezugriff) – für die Wartungsplattform
OPS_DATABASE_URL="postgresql://tdd_ops:CHANGE_ME@localhost:5432/tdd"

# Session-/Cookie-Geheimnis (langer Zufallsstring, z. B. `openssl rand -hex 32`)
SESSION_SECRET="CHANGE_ME_32_bytes_hex"

# Öffentliche Basis-URL (für Links in E-Mails: Passwort-Reset, Konto-Bestätigung)
APP_URL="https://tdd.schaer-systems.at"

# Subdomains (austauschbar, falls der Verein später eine eigene Domain bekommt)
APP_DOMAIN="tdd.schaer-systems.at"
OPS_DOMAIN="tdd-ops.schaer-systems.at"

# SMTP für Erinnerungen (ablaufende Karten) und Passwort-Reset
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="TDD-Verwaltung <noreply@tdd.schaer-systems.at>"

# Ablage für Fotos/Scans (verschlüsseltes Volume auf dem Server)
STORAGE_DIR="./data/uploads"

# Token für interne Jobs (Karten-Ablauf-Benachrichtigung) – langer Zufallsstring
JOB_TOKEN="CHANGE_ME"
