# Caddyfile auf dem Server (/opt/tdd/Caddyfile). Wird NICHT vom Deploy ueberschrieben;
# Aenderungen von Hand einspielen: docker exec tdd-caddy caddy validate --config /etc/caddy/Caddyfile
#                                  docker exec tdd-caddy caddy reload   --config /etc/caddy/Caddyfile

{
    # Mandanten-Hosts (055): Zertifikat bei Bedarf, aber nur fuer Hosts, die die Fach-App kennt
    # (tenants.host eines aktiven Mandanten oder TENANT_HOSTS). Verhindert Missbrauch der
    # On-Demand-Ausstellung durch beliebige DNS-Eintraege auf diese IP.
    on_demand_tls {
        ask http://tdd-web:3000/api/tls-ask
    }
}

# Wartungsmodus als Baustein: existiert /opt/tdd/ops/wartung.flag (Schalter der Wartungsplattform),
# bekommen alle Besucher:innen die Hinweisseite mit 503. Kein Neustart noetig.
(fachapp) {
    encode zstd gzip
    @wartung file {
        root /ops
        try_files wartung.flag
    }
    handle @wartung {
        root * /ops
        rewrite * /wartung.html
        header Retry-After 120
        file_server {
            status 503
        }
    }
    reverse_proxy tdd-web:3000
}

# Bestandsmandant Tischlein deck dich Vorarlberg
tdd.schaer-systems.at {
    import fachapp
}

# Weitere Mandanten: eigener Host je Unternehmen (DNS-A-Record auf diesen Server,
# Host in der Wartungsplattform unter Mandanten (Unternehmen) eingetragen).
https:// {
    tls {
        on_demand
    }
    import fachapp
}
http:// {
    redir https://{host}{uri} permanent
}

# Wartungsplattform / Super-Admin (nur Betreiber, Login + 2FA). DNS-A-Record
# tddops.schaer-systems.at -> 49.13.128.107; Zertifikat holt Caddy automatisch.
tddops.schaer-systems.at {
    encode zstd gzip
    header {
        X-Robots-Tag "noindex, nofollow"
        Strict-Transport-Security "max-age=31536000"
    }
    reverse_proxy tdd-ops:3000
}
